# Headless WordPress (admin.galaxisok.hu). Server-side fetch only.
WORDPRESS_URL=https://admin.galaxisok.hu

# Server-only credentials for relaying anonymous comments into moderation.
WORDPRESS_COMMENT_USERNAME=
WORDPRESS_COMMENT_APPLICATION_PASSWORD=

# Comma-separated names visitors may not use in comments (e.g. the admin's name).
COMMENT_RESERVED_NAMES=

# Shared secret for POST /api/revalidate after a WP publish.
WORDPRESS_REVALIDATE_SECRET=

# Tesztoldal / dev domain password gate.
SITE_PASSWORD=galamb

# Public URL of this deploy (OG + metadata).
NEXT_PUBLIC_SITE_URL=https://galaxisok-dev.vercel.app

# Mailchimp is configured in WordPress admin:
# Beállítások → Galaxisok Hírlevél (API key + Audience ID).
# Optional: MC4WP plugin API key is used as fallback.
